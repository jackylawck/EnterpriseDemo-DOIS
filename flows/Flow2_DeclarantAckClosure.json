{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {},
  "triggers": {
    "When_an_item_is_created_or_modified": {
      "type": "OpenApiConnectionWebhook",
      "inputs": {
        "host": {
          "connectionName": "shared_sharepointonline",
          "operationId": "HttpRequestWebhook",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
        },
        "parameters": {
          "dataset": "https://demo-tenant.sharepoint.com/sites/hr",
          "table": "Demo_Gift_Declarations"
        }
      },
      "conditions": [
        {
          "expression": "@and(equals(triggerOutputs()?['body/Status/Value'], '已完成歸檔'), not(equals(triggerOutputs()?['body/DeclarantAckStatus/Value'], '申報人已確認')))"
        }
      ]
    }
  },
  "actions": {
    "Start_and_wait_for_Declarant_Closure_Ack": {
      "type": "OpenApiConnectionWebhook",
      "inputs": {
        "host": {
          "connectionName": "shared_approvals",
          "operationId": "StartAndWaitForAnApproval",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals"
        },
        "parameters": {
          "approvalType": "CustomResponse",
          "responseOptions": [
            "Acknowledge (本人確認上述安排)"
          ],
          "title": "@concat('[Closure Ack | 處置確認] Final Disposal Arrangement Acknowledgement (Ref: ', triggerOutputs()?['body/Title'], ')')",
          "assignedTo": "@triggerOutputs()?['body/DeclarantEmail']",
          "itemLink": "@triggerOutputs()?['body/{Link}']"
        }
      }
    },
    "Update_item_Write_Ack_Record": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_sharepointonline",
          "operationId": "PatchItem",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
        },
        "parameters": {
          "dataset": "https://demo-tenant.sharepoint.com/sites/hr",
          "table": "Demo_Gift_Declarations",
          "id": "@triggerOutputs()?['body/ID']",
          "item/DeclarantAckStatus": {
            "Value": "申報人已確認"
          },
          "item/DeclarantAckDate": "@convertTimeZone(utcNow(), 'UTC', 'China Standard Time')"
        }
      },
      "runAfter": {
        "Start_and_wait_for_Declarant_Closure_Ack": [
          "Succeeded"
        ]
      }
    },
    "Send_Final_Audit_Receipt_Email": {
      "type": "OpenApiConnection",
      "description": "Send a legally defensible digital receipt to the declarant to close the loop. / 寄送具備法律防禦效力的數位收據給申報人，完成最終閉環。",
      "inputs": {
        "host": {
          "connectionName": "shared_office365",
          "operationId": "SendEmailV2",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
        },
        "parameters": {
          "emailMessage/To": "@triggerOutputs()?['body/DeclarantEmail']",
          "emailMessage/Subject": "@concat('[Case Closed | 案件完結] Declaration Acknowledged - ', triggerOutputs()?['body/Title'])",
          "emailMessage/Body": "<p>Thank you. Your acknowledgment has been recorded with a digital timestamp.<br>感謝您的確認，系統已寫入數位時間戳記，本利益申報案卷已正式歸檔完結。</p><p><strong>Audit Timestamp (HKT):</strong> @{convertTimeZone(utcNow(), 'UTC', 'China Standard Time')}</p>"
        }
      },
      "runAfter": {
        "Update_item_Write_Ack_Record": [
          "Succeeded"
        ]
      }
    }
  }
}
