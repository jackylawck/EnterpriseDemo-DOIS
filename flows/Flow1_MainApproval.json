{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {},
  "triggers": {
    "When_a_new_response_is_submitted": {
      "type": "OpenApiConnectionWebhook",
      "inputs": {
        "host": {
          "connectionName": "shared_microsoftforms",
          "operationId": "WebhookFormResponse",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_microsoftforms"
        },
        "parameters": {
          "formId": "DEMO_FORM_ID_PLACEHOLDER"
        }
      }
    }
  },
  "actions": {
    "Get_response_details": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_microsoftforms",
          "operationId": "GetFormResponseById",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_microsoftforms"
        },
        "parameters": {
          "formId": "DEMO_FORM_ID_PLACEHOLDER",
          "responseId": "@triggerOutputs()?['body/resourceData/responseId']"
        }
      },
      "runAfter": {}
    },
    "Create_item": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_sharepointonline",
          "operationId": "PostItem",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
        },
        "parameters": {
          "dataset": "https://demo-tenant.sharepoint.com/sites/hr",
          "table": "Demo_Gift_Declarations",
          "item/Title": "@concat('DEC-', utcNow('yyyyMMdd'), '-', triggerOutputs()?['body/resourceData/responseId'])",
          "item/DeclarantName": "@outputs('Get_response_details')?['body/r_declarant_name']",
          "item/DeclarantEmail": "@outputs('Get_response_details')?['body/responder']",
          "item/Department": "@outputs('Get_response_details')?['body/r_department']",
          "item/Status": {
            "Value": "待HR初審"
          },
          "item/DeclarantAckStatus": {
            "Value": "待申報人確認"
          }
        }
      },
      "runAfter": {
        "Get_response_details": [
          "Succeeded"
        ]
      }
    },
    "Break_Role_Inheritance_RLS": {
      "type": "OpenApiConnection",
      "description": "Row-Level Security (RLS) API call to break inheritance and implement Zero-Trust confidentiality. / 呼叫 API 打斷 SharePoint 權限繼承，落實零信任與 ISO 27001 機密性。",
      "inputs": {
        "host": {
          "connectionName": "shared_sharepointonline",
          "operationId": "HttpRequest",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
        },
        "parameters": {
          "dataset": "https://demo-tenant.sharepoint.com/sites/hr",
          "parameters/method": "POST",
          "parameters/uri": "_api/lists/getByTitle('Demo_Gift_Declarations')/items(@{outputs('Create_item')?['body/ID']})/breakroleinheritance(copyRoleAssignments=false, clearSubscopes=true)"
        }
      },
      "runAfter": {
        "Create_item": [
          "Succeeded"
        ]
      }
    },
    "Parse_JSON": {
      "type": "ParseJson",
      "inputs": {
        "content": "@outputs('Get_response_details')?['body/r_attachments']",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "link": { "type": "string" },
              "id": { "type": "string" }
            },
            "required": ["name", "link"]
          }
        }
      },
      "runAfter": {
        "Break_Role_Inheritance_RLS": [
          "Succeeded"
        ]
      }
    },
    "Apply_to_each_attachment": {
      "type": "Foreach",
      "foreach": "@body('Parse_JSON')",
      "actions": {
        "Get_file_content_by_path": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_onedriveforbusiness",
              "operationId": "GetFileContentByPath",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness"
            },
            "parameters": {
              "path": "@concat('/Apps/Microsoft Forms/Demo_Gift_Declaration_Form/Question/', items('Apply_to_each_attachment')?['name'])"
            }
          }
        },
        "Add_attachment": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "AddAttachment",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "https://demo-tenant.sharepoint.com/sites/hr",
              "table": "Demo_Gift_Declarations",
              "id": "@outputs('Create_item')?['body/ID']",
              "name": "@items('Apply_to_each_attachment')?['name']",
              "fileContent": "@body('Get_file_content_by_path')"
            }
          },
          "runAfter": {
            "Get_file_content_by_path": [
              "Succeeded"
            ]
          }
        }
      },
      "runAfter": {
        "Parse_JSON": [
          "Succeeded"
        ]
      }
    },
    "Start_and_wait_for_HR_Review": {
      "type": "OpenApiConnectionWebhook",
      "inputs": {
        "host": {
          "connectionName": "shared_approvals",
          "operationId": "StartAndWaitForAnApproval",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals"
        },
        "parameters": {
          "approvalType": "ApproveReject",
          "title": "@concat('[Part B Review | 乙部初審] ', outputs('Get_response_details')?['body/r_declarant_name'], ' - ', outputs('Get_response_details')?['body/r_department'])",
          "assignedTo": "hr@demo-enterprise.local",
          "itemLink": "@outputs('Create_item')?['body/{Link}']"
        }
      },
      "runAfter": {
        "Apply_to_each_attachment": [
          "Succeeded"
        ]
      }
    },
    "Condition_Check_HR_Result": {
      "type": "If",
      "expression": {
        "equals": [
          "@outputs('Start_and_wait_for_HR_Review')?['body/outcome']",
          "Approve"
        ]
      },
      "actions": {
        "Update_item_Pending_MD_Approval": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "PatchItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "https://demo-tenant.sharepoint.com/sites/hr",
              "table": "Demo_Gift_Declarations",
              "id": "@outputs('Create_item')?['body/ID']",
              "item/HRReviewResult": "Approve",
              "item/HRReviewComments": "@first(outputs('Start_and_wait_for_HR_Review')?['body/responses'])?['comments']",
              "item/Status": {
                "Value": "待管理層批核"
              }
            }
          }
        },
        "Post_Adaptive_Card_to_MD": {
          "type": "OpenApiConnectionWebhook",
          "description": "Executive Adaptive Card (UI/UX Optimization) / 運用調適型卡片提供高階主管下拉選單決策，取代冗長的傳統審批按鈕。",
          "inputs": {
            "host": {
              "connectionName": "shared_teams",
              "operationId": "PostCardAndWaitForResponse",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
            },
            "parameters": {
              "recipient": "manager@demo-enterprise.local",
              "message": {
                "type": "AdaptiveCard",
                "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                "version": "1.4",
                "body": [
                  {
                    "type": "TextBlock",
                    "text": "[Part C Directive] Statutory Disposal Decision / 丙部法定處置批示",
                    "weight": "Bolder",
                    "size": "Medium",
                    "color": "Accent"
                  },
                  {
                    "type": "TextBlock",
                    "text": "Please select the disposal method from the dropdown below / 請於下方選擇對應之法定處置選項：",
                    "wrap": true
                  },
                  {
                    "type": "Input.ChoiceSet",
                    "id": "mdDecision",
                    "style": "compact",
                    "isMultiSelect": false,
                    "choices": [
                      { "title": "Keep by Declarant (由申報人保留)", "value": "由申報人保留" },
                      { "title": "Display in Office (作陳列之用)", "value": "作陳列之用" },
                      { "title": "Share with Staff (與職員分享)", "value": "與職員分享" },
                      { "title": "Use for Lucky Draw (作抽獎之用)", "value": "作抽獎之用" },
                      { "title": "Donate to Charity (送贈慈善機構)", "value": "送贈慈善機構" },
                      { "title": "Return to Offeror (退回提供者)", "value": "退回提供者" },
                      { "title": "Others - Specify Below (其他 - 請填寫備註)", "value": "其他" }
                    ]
                  },
                  {
                    "type": "Input.Text",
                    "id": "mdComments",
                    "placeholder": "Additional directives or comments / 附加指示或備註 (Optional)",
                    "isMultiline": true
                  }
                ],
                "actions": [
                  {
                    "type": "Action.Submit",
                    "title": "Submit Directive (提交批示)"
                  }
                ]
              }
            }
          },
          "runAfter": {
            "Update_item_Pending_MD_Approval": [
              "Succeeded"
            ]
          }
        },
        "Update_item_Pending_HR_Execution": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "PatchItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "https://demo-tenant.sharepoint.com/sites/hr",
              "table": "Demo_Gift_Declarations",
              "id": "@outputs('Create_item')?['body/ID']",
              "item/MDDecision": "@outputs('Post_Adaptive_Card_to_MD')?['body/data/mdDecision']",
              "item/MDComments": "@outputs('Post_Adaptive_Card_to_MD')?['body/data/mdComments']",
              "item/Status": {
                "Value": "待HR執行處置"
              }
            }
          },
          "runAfter": {
            "Post_Adaptive_Card_to_MD": [
              "Succeeded"
            ]
          }
        },
        "Send_notification_email_to_HR_for_execution": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/To": "hr@demo-enterprise.local",
              "emailMessage/Subject": "[Action Required | 請執行處置] Management has approved the declaration / 管理層已批示利益申報",
              "emailMessage/Body": "<p>Management has completed the review via Adaptive Card. Please execute the directives and update the list status to Archived.<br><br>管理層已透過調適型卡片完成批核，請按指示執行並於清單更新記錄後改為已完成歸檔。</p>"
            }
          },
          "runAfter": {
            "Update_item_Pending_HR_Execution": [
              "Succeeded"
            ]
          }
        }
      },
      "runAfter": {
        "Start_and_wait_for_HR_Review": [
          "Succeeded"
        ]
      }
    },
    "else": {
      "actions": {
        "Update_item_HR_Rejected": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "PatchItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "https://demo-tenant.sharepoint.com/sites/hr",
              "table": "Demo_Gift_Declarations",
              "id": "@outputs('Create_item')?['body/ID']",
              "item/HRReviewResult": "Reject",
              "item/HRReviewComments": "@first(outputs('Start_and_wait_for_HR_Review')?['body/responses'])?['comments']",
              "item/Status": {
                "Value": "HR退回申報"
              }
            }
          }
        },
        "Send_rejection_email_to_employee": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/To": "@outputs('Get_response_details')?['body/responder']",
              "emailMessage/Subject": "[Action Required | 申報退回通知] Your declaration was rejected / 閣下提交之申報未能通過初審",
              "emailMessage/Body": "<p>Your declaration did not pass the initial review. Please correct the information according to HR's comments.<br><br>申報未能通過初審，請依照 HR 備註補正資料。</p>"
            }
          },
          "runAfter": {
            "Update_item_HR_Rejected": [
              "Succeeded"
            ]
          }
        }
      }
    }
  }
}
